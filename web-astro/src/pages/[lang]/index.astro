---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { homeContent, LOCALES, SITE_URL, type Locale } from '../../data/site';
import { localizedPath } from '../../utils/paths';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const content = homeContent[lang];
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang);
const alternatePath = localizedPath(otherLang);
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Belén Juárez',
    url: SITE_URL,
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Belén Juárez Jiménez',
    url: new URL(canonicalPath, SITE_URL).href,
    jobTitle: lang === 'es' ? 'Poeta, artista y profesora universitaria' : 'Poète, artiste et professeure universitaire',
    birthPlace: {
      '@type': 'Place',
      name: 'Paris',
    },
    homeLocation: {
      '@type': 'Place',
      name: 'Granada',
    },
    knowsAbout: [
      'Poesía',
      'Literatura',
      'Poesía visual',
      'Arte',
      'Música',
      'Microbiología',
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={content.seoTitle}
  description={content.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  schemas={schemas}
>
  <section class="hero">
    <div class="hero-media">
      <picture>
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset="/images/home/hero-books-480.avif 480w, /images/home/hero-books-768.avif 768w"
          sizes="100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset="/images/home/hero-books-480.webp 480w, /images/home/hero-books-768.webp 768w"
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset="/images/home/hero-books-1280.avif 1280w, /images/home/hero-books-1920.avif 1920w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/home/hero-books-1280.webp 1280w, /images/home/hero-books-1920.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/images/home/hero-books-1280.webp"
          width="1280"
          height="720"
          alt={content.imageAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <div class="hero-overlay" aria-hidden="true"></div>
    </div>
    <div class="hero-content">
      <h2 class="eyebrow hero-eyebrow-motion">{content.disciplines}</h2>
      <h1 class="hero-title-motion">
        <span>{content.titleLineOne}</span><br />
        <span>{content.titleLineTwo}</span>
      </h1>
      <blockquote class="hero-quote-motion">
        <p>“{content.firstQuote}”</p>
        <p>“{content.secondQuote}”</p>
      </blockquote>
    </div>
  </section>
</BaseLayout>
