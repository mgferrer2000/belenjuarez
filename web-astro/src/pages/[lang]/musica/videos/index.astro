---
import MusicPageShell from '../../../../components/MusicPageShell.astro';
import { getMusicVideos, musicContent } from '../../../../data/music';
import { LOCALES, SITE_URL, type Locale } from '../../../../data/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { localizedPath } from '../../../../utils/paths';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const content = musicContent[lang];
const page = getMusicVideos(lang);
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, 'musica/videos');
const alternatePath = localizedPath(otherLang, 'musica/videos');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: page.title,
  description: page.introduction,
  inLanguage: lang,
  url: new URL(canonicalPath, SITE_URL).href,
  hasPart: page.items.map((item) => ({
    '@type': 'VideoObject',
    name: item.title,
    description: item.description || undefined,
    thumbnailUrl: `https://img.youtube.com/vi/${item.youtubeId}/maxresdefault.jpg`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${item.youtubeId}`,
    contentUrl: `https://www.youtube.com/watch?v=${item.youtubeId}`,
    creator: { '@type': 'Person', name: 'Belén Juárez Jiménez' },
  })),
};
---
<BaseLayout
  lang={lang}
  title={`${page.title} | Música de Belén Juárez`}
  description={page.introduction}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  image={`https://img.youtube.com/vi/${page.items[0].youtubeId}/maxresdefault.jpg`}
  type="article"
  schemas={[schema]}
>
  <MusicPageShell lang={lang} activePath="videos">
    <section class="react-music-videos">
      <header class="react-music-section-heading">
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3Z"/></svg>
          <h2>{page.title}</h2>
        </div>
        <p>{page.introduction}</p>
      </header>

      <div class="react-video-grid">
        {page.items.map((item, index) => (
          <article style={`--video-delay:${index * 60}ms`}>
            <div class="react-video-frame" data-video-frame>
              <iframe
                class="react-video-desktop"
                src={`https://www.youtube-nocookie.com/embed/${item.youtubeId}?rel=0`}
                title={item.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
              <button
                class="react-video-mobile"
                type="button"
                data-video-id={item.youtubeId}
                data-video-title={item.title}
                aria-label={`${content.play}: ${item.title}`}
              >
                <img src={`https://i.ytimg.com/vi/${item.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
                <span aria-hidden="true">▶</span>
              </button>
            </div>
            <div class="react-video-copy">
              <header>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg>
                <h3>{item.title}</h3>
              </header>
              {item.description && <p>{item.description}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  </MusicPageShell>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach((button) => {
      button.addEventListener('click', () => {
        const frame = button.closest<HTMLElement>('[data-video-frame]');
        const id = button.dataset.videoId;
        const title = button.dataset.videoTitle || 'YouTube video';
        if (!frame || !id) return;
        frame.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0" title="${title}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
      });
    });
  </script>
</BaseLayout>
