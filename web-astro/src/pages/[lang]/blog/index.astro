---
import NotionJournal from '../../../components/NotionJournal'; import { BLOG_MESSAGES } from '@legacy/i18n/blogMessages'; import { LOCALES, SITE_URL, type Locale } from '../../../data/site'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import { localizedPath } from '../../../utils/paths';
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); } const { lang } = Astro.props as { lang: Locale }; const page = BLOG_MESSAGES[lang]; const otherLang: Locale = lang === 'es' ? 'fr' : 'es'; const canonicalPath = localizedPath(lang, 'blog'); const alternatePath = localizedPath(otherLang, 'blog'); const schema = { '@context': 'https://schema.org', '@type': 'Blog', name: page.title, description: page.introduction, inLanguage: lang, url: new URL(canonicalPath, SITE_URL).href, author: { '@type': 'Person', name: 'Belén Juárez Jiménez' } };
---
<BaseLayout lang={lang} title={`${page.title} | Belén Juárez`} description={page.introduction} canonicalPath={canonicalPath} alternatePath={alternatePath} type="article" schemas={[schema]}><section class="journal-page content-shell"><header><h1>{page.title}</h1><p>{page.introduction}</p></header><NotionJournal client:load locale={lang} section="blog" mode="list" /></section></BaseLayout>
