---
import LiterarySectionNav from '../../../../components/LiterarySectionNav.astro';
import { getPrologueWorks, prologueContent } from '../../../../data/prologues';
import { LOCALES, SITE_URL, type Locale } from '../../../../data/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { localizedPath } from '../../../../utils/paths';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Locale };
const content = prologueContent[lang];
const works = getPrologueWorks(lang);
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, 'obra-literaria/prologos');
const alternatePath = localizedPath(otherLang, 'obra-literaria/prologos');
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: content.title, description: content.description, url: new URL(canonicalPath, SITE_URL).href, inLanguage: lang, hasPart: works.map((work) => ({ '@type': work.slug === 'quimica-del-amor' ? 'Chapter' : 'Article', headline: work.title, datePublished: work.year, author: { '@type': 'Person', name: 'Belén Juárez' }, isPartOf: { '@type': 'CreativeWork', name: work.publication }, url: new URL(localizedPath(lang, `obra-literaria/prologos/${work.slug}`), SITE_URL).href })) };
---

<BaseLayout lang={lang} title={content.seoTitle} description={content.description} canonicalPath={canonicalPath} alternatePath={alternatePath} image={works[0]?.coverUrl} type="article" schemas={[schema]}>
  <article class="react-literary-page content-shell">
    <h1>{content.sectionTitle}</h1>
    <LiterarySectionNav lang={lang} activePath="prologos" />
    <div class="react-prologues">
      <header class="react-archive-heading">
        <p class="react-archive-kicker"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V5a2 2 0 0 1 2-2h5a3 3 0 0 1 3 3v15a3 3 0 0 0-3-3Z"></path><path d="M21 18a1 1 0 0 0 1-1V5a2 2 0 0 0-2-2h-5a3 3 0 0 0-3 3v15a3 3 0 0 1 3-3Z"></path></svg>{content.eyebrow}</p>
        <h2>{content.title}</h2>
        <span aria-hidden="true"></span>
        <div>{content.introduction.map((paragraph) => <p>{paragraph}</p>)}</div>
      </header>
      <div class="react-editorial-grid">
        {works.map((work) => {
          const detailPath = localizedPath(lang, `obra-literaria/prologos/${work.slug}`);
          return (
            <article class="react-editorial-card">
              <a class="react-editorial-cover" href={detailPath}>
                <img src={work.coverUrl} alt={content.cover(work.title)} loading="lazy" />
                <span><small>{content.openReading}</small><strong>{work.title}</strong></span>
              </a>
              <div class="react-editorial-copy">
                <p class="react-editorial-year">{work.year || content.archiveFallback}</p>
                <div class="react-editorial-title">
                  <h3><a href={detailPath}>{work.title}</a></h3>
                  <p>{work.publication}</p>
                  <small>{work.typeLabel}</small>
                </div>
                <p class="react-editorial-description">{work.description}</p>
                <a class="react-editorial-link" href={detailPath}>{content.read}<span>→</span></a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </article>
</BaseLayout>
