---
import { COLLABORATIONS } from '@legacy/constants';
import LiterarySectionNav from '../../../../components/LiterarySectionNav.astro';
import { anthologiesContent, getAnthologies } from '../../../../data/anthologies';
import { LOCALES, SITE_URL, type Locale } from '../../../../data/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { parseLiteraryParagraph } from '../../../../utils/literaryText';
import { localizedPath } from '../../../../utils/paths';

export function getStaticPaths() { return LOCALES.flatMap((lang) => COLLABORATIONS.map((entry) => ({ params: { lang, id: entry.id }, props: { lang, id: entry.id } }))); }
const { lang, id } = Astro.props as { lang: Locale; id: string };
const content = anthologiesContent[lang];
const entry = getAnthologies(lang).find((item) => item.id === id)!;
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, `obra-literaria/antologias/${id}`);
const alternatePath = localizedPath(otherLang, `obra-literaria/antologias/${id}`);
const seoDescription = entry.description.length >= 40 ? entry.description : lang === 'es'
  ? `«${entry.title}», texto de Belén Juárez publicado en ${entry.publication} (${entry.date}).`
  : `« ${entry.title} », texte de Belén Juárez publié dans ${entry.publication} (${entry.date}).`;
const rawParagraphs = (entry.fullText?.trim() || entry.description).split('\n\n');
const paragraphs = rawParagraphs.map(parseLiteraryParagraph);
const schema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: entry.title, description: seoDescription,
  author: { '@type': 'Person', name: 'Belén Juárez Jiménez', url: SITE_URL }, datePublished: entry.date,
  inLanguage: lang, image: new URL(entry.coverUrl, SITE_URL).href,
  isPartOf: { '@type': entry.type === 'Revista' || entry.type === 'Revue' ? 'PublicationIssue' : 'Book', name: entry.publication },
  text: entry.fullText?.replace(/\[\[IMG:(?:L|R|BR|B):\d+\]\]/g, '').replaceAll('*', '').replaceAll('_', ''),
  url: new URL(canonicalPath, SITE_URL).href,
};
---

<BaseLayout lang={lang} title={`${entry.title} | ${entry.publication}`} description={seoDescription} canonicalPath={canonicalPath} alternatePath={alternatePath} image={entry.coverUrl} type="article" schemas={[schema]}>
  <article class="react-literary-page content-shell">
    <h1>{content.sectionTitle}</h1>
    <LiterarySectionNav lang={lang} activePath="antologias" />
    <section class:list={['react-anthology-detail', { wide: entry.id === '14' }]}>
      <a class="react-anthology-back" href={localizedPath(lang, 'obra-literaria/antologias')}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
        {content.back}
      </a>
      <div class="react-anthology-detail-grid">
        <aside class="react-anthology-detail-aside">
          <div>
            <figure><img src={entry.coverUrl} alt={entry.title} /></figure>
            <div class="react-anthology-actions">
              {entry.externalNote && entry.url && (
                <a class="react-anthology-detail-note" href={entry.url} target="_blank" rel="noopener noreferrer">{entry.externalNote}</a>
              )}
              {entry.url && (
                <a class="react-anthology-visit" href={entry.url} target="_blank" rel="noopener noreferrer">
                  {content.source}
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </a>
              )}
            </div>
          </div>
        </aside>
        <div class="react-anthology-detail-content">
          <header>
            <p class="react-anthology-detail-meta">
              <span>{entry.type}</span>
              <time>
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M3 10h18"/><rect width="18" height="18" x="3" y="4" rx="2"/></svg>
                {entry.date}
              </time>
            </p>
            <h2>{entry.title}</h2>
            <p>{content.inPublication} {entry.publication}</p>
          </header>
          <div class="react-anthology-literary-text">
            {paragraphs.map((paragraph) => {
              const left = paragraph.images.filter((image) => image.position === 'L');
              const right = paragraph.images.filter((image) => image.position === 'R');
              const bottomRight = paragraph.images.filter((image) => image.position === 'BR');
              const bottom = paragraph.images.filter((image) => image.position === 'B');
              const side = left.length ? left : right;
              const lines = <p>{paragraph.lines.map((line) => (
                <span class:list={['react-anthology-line', line.mode, { empty: line.empty }]} set:html={line.empty ? '&nbsp;' : line.html} />
              ))}</p>;
              const renderImageGroup = (images: typeof paragraph.images) => (
                <div class="react-anthology-image-group">
                  {images.map((image) => entry.images?.[image.index] && (
                    <figure><img src={entry.images[image.index]} alt={content.illustrationAlt(entry.title)} loading="lazy" /></figure>
                  ))}
                </div>
              );

              if (bottom.length) {
                return <section class="react-anthology-paragraph has-bottom">
                  {lines}
                  <div class="react-anthology-bottom-images">
                    {bottom.map((image) => entry.images?.[image.index] && (
                      <figure class:list={{ wide: entry.id === '14' }}>
                        <img src={entry.images[image.index]} alt={content.illustrationAlt(entry.title)} loading="lazy" />
                      </figure>
                    ))}
                  </div>
                </section>;
              }

              if (bottomRight.length) {
                return <section class="react-anthology-paragraph bottom-right">
                  {lines}
                  <div>{renderImageGroup(bottomRight)}</div>
                </section>;
              }

              if (side.length) {
                return <section class="react-anthology-paragraph">
                  <div class:list={['react-anthology-side-images', left.length ? 'left' : 'right']}>{renderImageGroup(side)}</div>
                  {lines}
                </section>;
              }

              return <section class="react-anthology-paragraph">{lines}</section>;
            })}
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
