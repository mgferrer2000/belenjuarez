---
import LiterarySectionNav from '../../../../components/LiterarySectionNav.astro';
import { anthologiesContent, getAnthologies } from '../../../../data/anthologies';
import { LOCALES, SITE_URL, type Locale } from '../../../../data/site';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { localizedPath } from '../../../../utils/paths';

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
const { lang } = Astro.props as { lang: Locale };
const content = anthologiesContent[lang];
const entries = getAnthologies(lang);
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, 'obra-literaria/antologias');
const alternatePath = localizedPath(otherLang, 'obra-literaria/antologias');
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: content.title, description: content.description,
  url: new URL(canonicalPath, SITE_URL).href, inLanguage: lang,
  hasPart: entries.map((entry) => ({ '@type': 'CreativeWork', name: entry.title, datePublished: entry.date, url: new URL(localizedPath(lang, `obra-literaria/antologias/${entry.id}`), SITE_URL).href })),
};
---

<BaseLayout lang={lang} title={content.seoTitle} description={content.description} canonicalPath={canonicalPath} alternatePath={alternatePath} image={entries.at(-1)?.coverUrl} type="article" schemas={[schema]}>
  <article class="react-literary-page content-shell">
    <h1>{content.sectionTitle}</h1>
    <LiterarySectionNav lang={lang} activePath="antologias" />
    <section class="react-anthologies-index">
      <h2 class="react-anthologies-heading">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        {content.title}
      </h2>
      <div class="react-anthologies-grid">
        {entries.map((entry) => {
          const detailPath = localizedPath(lang, `obra-literaria/antologias/${entry.id}`);
          return <article class="react-anthology-card">
            <div class="react-anthology-card-media">
              <a class="react-anthology-card-cover" href={detailPath}>
                <img src={entry.coverUrl} alt={entry.title} style={`object-position:${entry.imagePosition ?? 'center'}`} />
              </a>
              {entry.externalNote && entry.url && (
                <a class="react-anthology-external-note" href={entry.url} target="_blank" rel="noopener noreferrer">
                  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  <span>{entry.externalNote}</span>
                </a>
              )}
            </div>
            <div class="react-anthology-card-copy">
              <p class="react-anthology-card-meta">
                <time>{entry.date}</time><i aria-hidden="true"></i><span>{entry.type}</span>
              </p>
              <a class="react-anthology-card-title" href={detailPath}>
                <h3>{entry.title}</h3>
                <p>{content.inPublication} {entry.publication}</p>
              </a>
              <p class="react-anthology-card-description">{entry.description}</p>
              <a class="react-anthology-read-more" href={detailPath}>{content.read}<span aria-hidden="true">→</span></a>
            </div>
          </article>;
        })}
      </div>
    </section>
  </article>
</BaseLayout>
