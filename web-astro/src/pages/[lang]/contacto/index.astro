---
import { SOCIALS } from '@legacy/constants';
import { CONTACT_MESSAGES } from '@legacy/i18n/pageMessages';
import { LOCALES, SITE_URL, type Locale } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedPath } from '../../../utils/paths';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Locale };
const page = CONTACT_MESSAGES[lang];
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, 'contacto');
const alternatePath = localizedPath(otherLang, 'contacto');
const description = lang === 'es'
  ? 'Contacto profesional y cultural con Belén Juárez para lecturas, colaboraciones, prensa y proyectos artísticos.'
  : 'Contact professionnel et culturel avec Belén Juárez pour lectures, collaborations, presse et projets artistiques.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: page.title,
  description,
  url: new URL(canonicalPath, SITE_URL).href,
  inLanguage: lang,
  mainEntity: {
    '@type': 'Person',
    name: 'Belén Juárez Jiménez',
    sameAs: SOCIALS.map((social) => social.url),
  },
};
---
<BaseLayout
  lang={lang}
  title={`${page.title} | Belén Juárez`}
  description={description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  schemas={[schema]}
>
  <section id="contact" class="react-contact-page">
    <div class="react-contact-card">
      <header class="react-contact-heading">
        <h1>{page.title}</h1>
        <p>{page.introduction}</p>
      </header>

      <div class="react-contact-layout">
        <aside class="react-contact-socials">
          <h2>{page.socialHeading}</h2>
          <div>
            {SOCIALS.map((social) => (
              <a
                class={`react-social-link social-${social.platform.toLowerCase()}`}
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="react-social-icon" aria-hidden="true">
                  {social.platform === 'Instagram' ? (
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7"/></svg>
                  ) : (
                    <svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v5h4v-5h3l1-4h-4V9c0-.6.4-1 1-1Z"/></svg>
                  )}
                </span>
                <span>{social.platform}</span>
              </a>
            ))}
          </div>
        </aside>

        <form id="contact-form" data-subject-template={page.emailSubject('{name}')}>
          <label>
            <span>{page.nameLabel}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>{page.emailLabel}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>{page.messageLabel}</span>
            <textarea name="message" rows="4" required></textarea>
          </label>
          <button type="submit" data-idle={page.send} data-sending={page.sending}>
            <span data-button-label>{page.send}</span>
            <svg class="react-send-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            <svg class="react-loader-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg>
          </button>
          <p class="react-form-status" data-success={page.success} data-error={page.error} aria-live="polite">
            <svg class="success-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg>
            <svg class="error-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg>
            <span></span>
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = button?.querySelector<HTMLElement>('[data-button-label]');
    const status = form?.querySelector<HTMLElement>('.react-form-status');
    const statusLabel = status?.querySelector<HTMLElement>('span');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!button || !buttonLabel || !status || !statusLabel) return;

      const data = Object.fromEntries(new FormData(form).entries());
      const name = String(data.name ?? '').trim();
      const email = String(data.email ?? '').trim();
      const message = String(data.message ?? '').trim();
      if (!name || !email || !message) return;

      button.disabled = true;
      button.classList.add('sending');
      buttonLabel.textContent = button.dataset.sending ?? '';
      status.className = 'react-form-status';
      statusLabel.textContent = '';

      try {
        const subjectTemplate = form.dataset.subjectTemplate ?? '';
        const response = await fetch('https://formsubmit.co/ajax/contacto@belenjuarez.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...data, _subject: subjectTemplate.replace('{name}', name) }),
        });
        if (!response.ok) throw new Error('send');
        form.reset();
        status.classList.add('success');
        statusLabel.textContent = status.dataset.success ?? '';
      } catch {
        status.classList.add('error');
        statusLabel.textContent = status.dataset.error ?? '';
      } finally {
        button.disabled = false;
        button.classList.remove('sending');
        buttonLabel.textContent = button.dataset.idle ?? '';
        window.setTimeout(() => {
          status.className = 'react-form-status';
          statusLabel.textContent = '';
        }, 5000);
      }
    });
  </script>
</BaseLayout>
