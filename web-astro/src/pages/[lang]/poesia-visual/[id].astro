---
import { VISUAL_POETRY } from '@legacy/constants';
import { getVisualPoetry, visualPoetryContent } from '../../../data/visual-poetry';
import { LOCALES, SITE_URL, type Locale } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedPath } from '../../../utils/paths';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => VISUAL_POETRY.map((collection) => ({ params: { lang, id: collection.id }, props: { lang, id: collection.id } })));
}

const { lang, id } = Astro.props as { lang: Locale; id: string };
const content = visualPoetryContent[lang];
const collection = getVisualPoetry(lang).find((item) => item.id === id)!;
const otherLang: Locale = lang === 'es' ? 'fr' : 'es';
const canonicalPath = localizedPath(lang, `poesia-visual/${id}`);
const alternatePath = localizedPath(otherLang, `poesia-visual/${id}`);
const seoDescription = lang === 'es'
  ? `Colección «${collection.title}» de Belén Juárez: obras de poesía visual que integran palabra, composición e imagen.`
  : `Collection « ${collection.title} » de Belén Juárez : œuvres de poésie visuelle réunissant parole, composition et image.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWorkSeries',
  name: collection.title,
  description: seoDescription,
  url: new URL(canonicalPath, SITE_URL).href,
  inLanguage: lang,
  creator: { '@type': 'Person', name: 'Belén Juárez Jiménez', url: SITE_URL },
  image: collection.artworkImages.map((image) => new URL(image, SITE_URL).href),
  hasPart: collection.artworkImages.map((image, index) => ({ '@type': 'VisualArtwork', name: `${collection.title} · ${content.artwork(index + 1)}`, image: new URL(image, SITE_URL).href, creator: { '@type': 'Person', name: 'Belén Juárez Jiménez' } })),
};
---

<BaseLayout lang={lang} title={`${collection.title} | ${content.title}`} description={seoDescription} canonicalPath={canonicalPath} alternatePath={alternatePath} image={collection.coverImage} type="article" schemas={[schema]}>
  <article class="react-visual-detail">
    <div class="react-visual-detail-shell">
      <header class="react-visual-detail-header">
        <a class="react-visual-back" href={localizedPath(lang, 'poesia-visual')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path><path d="M9 12h10"></path></svg>
          {content.back}
        </a>
        <div class="react-visual-detail-title">
          <h1>{collection.title}</h1>
          {collection.description && <p>{collection.description}</p>}
        </div>
      </header>

      <div class="react-visual-divider"></div>

      <section class:list={['react-visual-artworks', { 'has-three-columns': collection.artworkImages.length > 2 }]} aria-label={collection.title}>
        {collection.artworkImages.map((image, index) => (
          <button
            type="button"
            class="react-visual-artwork"
            data-lightbox-src={image}
            data-lightbox-alt={`${collection.title} - ${content.artwork(index + 1)}`}
            aria-label={`${lang === 'es' ? 'Ampliar' : 'Agrandir'}: ${content.artwork(index + 1)}`}
          >
            <img src={image} alt={`${collection.title} - ${content.artwork(index + 1)}`} loading={index === 0 ? 'eager' : 'lazy'} />
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-5-5L5 21"></path></svg>
            </span>
          </button>
        ))}
      </section>

      {collection.poemText && (
        <section class="react-visual-poem">
          <span aria-hidden="true"></span>
          <pre>{collection.poemText}</pre>
        </section>
      )}
    </div>
  </article>

  <dialog class="react-visual-lightbox" aria-label={content.close}>
    <button type="button" class="react-visual-lightbox-close" aria-label={content.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
    <img src="" alt="" />
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.react-visual-lightbox');
    const image = dialog?.querySelector<HTMLImageElement>('img');
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !image) return;
        image.src = button.dataset.lightboxSrc ?? '';
        image.alt = button.dataset.lightboxAlt ?? '';
        dialog.showModal();
      });
    });
    dialog?.querySelector<HTMLButtonElement>('.react-visual-lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && dialog?.open) dialog.close(); });
  </script>
</BaseLayout>
