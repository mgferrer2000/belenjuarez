---
import { LOCALES, localeDetails, navigation, type Locale } from '../data/site';
import { localizedPath } from '../utils/paths';

interface Props {
  lang: Locale;
  currentPath: string;
  alternatePath: string;
}

const { lang, currentPath, alternatePath } = Astro.props;
const menuLabel = lang === 'es' ? 'Menú principal' : 'Menu principal';
const openMenuLabel = lang === 'es' ? 'Abrir menú' : 'Ouvrir le menu';

const languageHref = (target: Locale) => target === lang ? currentPath : alternatePath;
---

<header class="site-header" data-site-header>
  <div class="nav-shell">
    <a class="brand" href={localizedPath(lang)} aria-label={`${localeDetails[lang].name}: Belén Juárez`}>
      BELÉN JUÁREZ
    </a>

    <nav class="desktop-nav" aria-label={lang === 'es' ? 'Navegación principal' : 'Navigation principale'}>
      {navigation[lang].map((item) => {
        const href = localizedPath(lang, item.path);
        const active = item.path === '' ? currentPath === href : currentPath.startsWith(href);
        return 'children' in item ? (
          <div class="nav-dropdown">
            <button class:list={['nav-parent', { active }]} type="button" aria-haspopup="true">
              {item.label}
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <div class="nav-dropdown-panel">
              {item.children.map((child) => <a href={localizedPath(lang, child.path)}>{child.label}</a>)}
            </div>
          </div>
        ) : <a href={href} aria-current={active ? 'page' : undefined}>{item.label}</a>;
      })}
    </nav>

    <div class="language-switch" aria-label={lang === 'es' ? 'Cambiar idioma' : 'Changer de langue'}>
      {LOCALES.map((target) => target === lang ? (
        <span aria-current="page" lang={target}>
          <span class:list={['language-flag', `flag-${target}`]} aria-hidden="true"></span>
          {localeDetails[target].shortName}
        </span>
      ) : (
        <a href={languageHref(target)} lang={target}>
          <span class:list={['language-flag', `flag-${target}`]} aria-hidden="true"></span>
          {localeDetails[target].shortName}
        </a>
      ))}
    </div>

    <button class="menu-toggle" type="button" aria-label={openMenuLabel} aria-controls="mobile-menu" aria-expanded="false">
      <svg class="menu-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <svg class="close-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <nav class="mobile-menu-inner" aria-label={menuLabel}>
      {navigation[lang].map((item) => 'children' in item ? (
        <div class="mobile-submenu">
          <button class="mobile-menu-item mobile-submenu-toggle" type="button" aria-expanded="false">
            {item.label}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="mobile-submenu-grid">
            {item.children.map((child) => <a href={localizedPath(lang, child.path)}>{child.label}</a>)}
          </div>
        </div>
      ) : (
        <a class="mobile-menu-item" href={localizedPath(lang, item.path)}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    const menuButton = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = header.querySelector<HTMLElement>('.mobile-menu');
    const submenuButtons = header.querySelectorAll<HTMLButtonElement>('.mobile-submenu-toggle');

    const updateHeader = () => header.classList.toggle('is-scrolled', window.scrollY > 50);
    const setMenuOpen = (open: boolean) => {
      header.classList.toggle('menu-is-open', open);
      menuButton?.setAttribute('aria-expanded', String(open));
      mobileMenu?.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('nav-open', open);
    };

    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
    menuButton?.addEventListener('click', () => setMenuOpen(!header.classList.contains('menu-is-open')));

    submenuButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const submenu = button.closest<HTMLElement>('.mobile-submenu');
        const open = !submenu?.classList.contains('is-open');
        submenu?.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', String(open));
      });
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1366) setMenuOpen(false);
    });
  }
</script>
